# Copy to .env and fill in. Never commit .env itself (see .gitignore).
# Reference: docs/PLATFORM.md §4, docs/SETUP.md 1.5.

# --- Core -------------------------------------------------------------
NODE_ENV=development

# Host-run `npm run dev` talks to Postgres via localhost; the containerised
# app (docker compose --profile full) uses the `postgres` service name
# instead — see docker-compose.yml, which sets this for you in that mode.
DATABASE_URL=postgresql://trackr:localdev_only_not_a_real_secret@localhost:5432/trackr_dev

# openssl rand -base64 32
SESSION_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Client IP arrives via X-Forwarded-For only behind a real proxy. Local: false.
TRUST_PROXY=false

# --- Email (SETUP.md Phase 2) ------------------------------------------
EMAIL_TRANSPORT=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025

# --- AI (SETUP.md Phase 2 — Google AI Studio, free tier for local dev) -
AI_PROVIDER=gemini
GEMINI_API_KEY=

# --- Google OAuth (SETUP.md Phase 2) ------------------------------------
# Redirect URI: http://localhost:3000/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Not needed yet (SETUP.md Phase 2) ----------------------------------
# BREVO_API_KEY=
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
