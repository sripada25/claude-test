                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "CjJKZ",
                          "name": "Salutation",
                          "fill": "$m-ink-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Dear Hiring Team,",
                          "lineHeight": 1.6,
                          "fontFamily": "$m-font-body",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "QPQ7F",
                          "fill": "$m-ink-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "I'm excited to apply for the Product Designer II role at Razorpay. Over the past four years I've led end-to-end design for checkout and onboarding flows at two fintech startups, and I'm drawn to Razorpay's focus on building payment infrastructure that scales with modern businesses.",
                          "lineHeight": 1.6,
                          "fontFamily": "$m-font-body",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "U6tqTl",
                          "fill": "$m-ink-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "In my current role at Zeta, I redesigned the merchant onboarding flow, cutting drop-off by 22% while working closely with engineering and compliance. I'd bring that same rigor to your checkout experience.",
                          "lineHeight": 1.6,
                          "fontFamily": "$m-font-body",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Y6zKr8",
                          "fill": "$m-ink-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "I'd welcome the chance to talk through how my background in fintech product design maps to what your team is building next.",
                          "lineHeight": 1.6,
                          "fontFamily": "$m-font-body",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "W0Dl1z",
                          "name": "Signoff",
                          "fill": "$m-ink-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
