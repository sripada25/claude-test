                          "fill": "$ink2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Sending on the user's behalf means mailbox OAuth, deliverability, and an entire class of trust and abuse problems. Copy and hand off instead.",
